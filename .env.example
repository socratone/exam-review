# 로컬 페이지 렌더링 해상도. --dpi 옵션이 있으면 그 값이 우선한다.
EXAM_CHECKER_RENDER_DPI=160
# Modal 배포 시 적용되는 GPU 종류. 변경 후에는 재배포해야 한다.
EXAM_CHECKER_GPU=L4
# 배포할 앱과 CLI가 조회할 앱 이름은 같아야 한다.
EXAM_CHECKER_MODAL_APP=exam-checker
# 검토 시 사용할 Qwen3-VL 모델. --model 옵션으로 실행별 변경이 가능하다.
EXAM_CHECKER_MODEL=Qwen/Qwen3-VL-8B-Instruct

# true와 API 키를 함께 설정해야 추적이 활성화된다.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=exam-checker
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# true이면 추출 텍스트, 프롬프트, 원시 응답도 LangSmith에 전송한다. PNG는 전송하지 않는다.
EXAM_CHECKER_TRACE_CONTENT=false
# 클라우드 추적을 설정한 뒤 Secret 이름을 지정하고 Modal 앱을 재배포한다.
EXAM_CHECKER_LANGSMITH_SECRET=
